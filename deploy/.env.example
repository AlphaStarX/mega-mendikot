# Mega Mindikot deployment environment.
# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- Your domain (the hostnames Caddy will obtain certs for) ---
PLAY_DOMAIN=play.mindikot.com
VOICE_DOMAIN=voice.mindikot.com

# --- Server's public IPv4 (passed to LiveKit as --node-ip) ---
# Find it with:  curl -s https://api.ipify.org
PUBLIC_IP=203.0.113.10

# --- PostgreSQL (account database) ---
# Generate the password on the box with:  openssl rand -base64 24
POSTGRES_USER=mm
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
POSTGRES_DB=mendikot
# DATABASE_URL is composed by docker-compose from the three above; the app reads it.

# --- Account auth (HS256 JWT signing secret) ---
# Generate on the box with:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_BASE64_SECRET

# --- LiveKit API credentials ---
# These MUST match deploy/livekit.yaml (key + secret).
# Generate the secret on the box with:  openssl rand -base64 32
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_BASE64_SECRET

# --- The WSS endpoint the browser connects to (Caddy-fronted signaling) ---
# Clients reach LiveKit signaling through Caddy's TLS on 443.
LIVEKIT_URL=wss://voice.mindikot.com
