// Mega Mindikot 5v5 — database schema.
// PostgreSQL is the one intentional runtime dependency (server-side); auth
// crypto stays zero-dependency (scrypt + HS256 via node:crypto). Phase 1 keeps
// the User table minimal — stats/XP/avatars/friends are additive migrations in
// later phases.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  passwordSalt String
  displayName  String
  createdAt    DateTime @default(now())

  // Phase 2 — aggregate lifetime stats. All default 0 so existing rows + new
  // signups start clean. Recorded incrementally in GameRoom.recordStats() at
  // match end. No per-match history yet (a later phase).
  wins          Int @default(0)
  losses        Int @default(0)
  draws         Int @default(0)
  matchesPlayed Int @default(0)
  tensCaptured  Int @default(0)

  // Reserved for later phases (added via additive migrations, not yet queried):
  //   xp, level, avatarUrl, country, playerId

  @@index([email])
}
