// Mega Mindikot 5v5 — database schema.
// PostgreSQL is the one intentional runtime dependency (server-side); auth
// crypto stays zero-dependency (scrypt + HS256 via node:crypto). Phase 1 keeps
// the User table minimal — stats/XP/avatars/friends are additive migrations in
// later phases.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  passwordSalt String
  displayName  String
  createdAt    DateTime @default(now())

  // Phase 2 — aggregate lifetime stats. All default 0 so existing rows + new
  // signups start clean. Recorded incrementally in GameRoom.recordStats() at
  // match end. No per-match history yet (a later phase).
  wins          Int @default(0)
  losses        Int @default(0)
  draws         Int @default(0)
  matchesPlayed Int @default(0)
  tensCaptured  Int @default(0)

  // Phase 4 — player identity. All nullable so the migration is safe for existing
  // rows; new signups get a playerId generated in handleSignup, existing rows get
  // one via lazy backfill on next login. country/avatar are null until the user
  // picks them on the Profile screen.
  playerId String? @unique   // shareable code (#A4F2K style, without the #), immutable
  country  String?           // 2-letter ISO code, rendered as a flag emoji client-side
  avatar   String?           // emoji from the curated palette (shared/identity.js)

  // Phase 5 — XP + player levels. xp is incremented in GameRoom.recordStats() at
  // match end (via xpForOutcome). level is derived from xp at read time
  // (levelFromXp) so it can never drift; also stored for future indexing/ranking.
  // New signups + existing rows start at 0 xp / level 1.
  xp    Int @default(0)
  level Int @default(1)

  // Phase 6 — friends. Back-relations for the Friendship model. A user has many
  // outgoing requests (they sent them) and many incoming (they're the recipient).
  incoming Friendship[] @relation("FriendshipFriend")
  outgoing Friendship[] @relation("FriendshipUser")

  @@index([email])
  @@index([wins])   // Phase 3 — backs the leaderboard's ORDER BY wins DESC
  @@index([playerId]) // Phase 4 — backs future "add friend by ID" lookup (Phase 6)
}

// Phase 6 — friendship edges. One row per ordered pair: userId = requester,
// friendId = recipient. status "pending" until the recipient accepts (then
// "accepted" = mutual friendship, app-level symmetry — NOT two rows). On delete
// of either user the edge cascades away. The unique pair prevents duplicate
// requests; the status indexes back the "my friends" + "incoming requests" queries.
model Friendship {
  id        String   @id @default(cuid())
  userId    String   // requester
  friendId  String   // recipient
  status    String   @default("pending")  // "pending" | "accepted"
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId, status])   // "my friends" / "my outgoing requests"
  @@index([friendId, status]) // "incoming requests"
}
